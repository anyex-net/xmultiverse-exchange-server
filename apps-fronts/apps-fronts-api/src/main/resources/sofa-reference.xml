<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sofa="http://sofastack.io/schema/sofaboot"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://sofastack.io/schema/sofaboot http://sofastack.io/schema/sofaboot.xsd">
    <!-- 项目业务消费者 -->
    <!-- 访问日志 -->
    <sofa:reference id="accessLogService" interface="com.anyex.apps.system.service.SysAccessLogService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>

</beans>
