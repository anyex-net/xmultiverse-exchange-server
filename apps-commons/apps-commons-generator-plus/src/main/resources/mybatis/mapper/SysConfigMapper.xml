<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anyex.apps.project.mapper.SysConfigMapper">

    <resultMap type="com.anyex.apps.project.domain.SysConfig" id="SysConfigResult">
        <id property="configId" column="config_id"/>
        <result property="author" column="author"/>
        <result property="moduleName" column="module_name"/>
        <result property="packageName" column="package_name"/>
        <result property="autoRemovePre" column="auto_remove_pre"/>
        <result property="tablePrefix" column="table_prefix"/>
    </resultMap>

    <sql id="selectSysConfigVo">
        select config_id, author, module_name, package_name, auto_remove_pre, table_prefix
        from sys_config
    </sql>

    <select id="selectSysConfig" resultMap="SysConfigResult">
        <include refid="selectSysConfigVo"/>
    </select>

    <update id="updateSysConfig" parameterType="com.anyex.apps.project.domain.SysConfig">
        update sys_config
        <set>
            <if test="author != null">author = #{author},</if>
            <if test="moduleName != null">module_name = #{moduleName},</if>
            <if test="packageName != null">package_name = #{packageName},</if>
            <if test="autoRemovePre != null">auto_remove_pre = #{autoRemovePre},</if>
            <if test="tablePrefix != null and tablePrefix != ''">table_prefix = #{tablePrefix},</if>
        </set>
        where config_id = #{configId}
    </update>
</mapper> 