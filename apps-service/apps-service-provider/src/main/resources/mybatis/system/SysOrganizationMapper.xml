    <resultMap id="organizationResultMap" type="com.anyex.apps.system.entity.SysOrganization">
        <id column="a.id" property="id" jdbcType="BIGINT" />
        <result column="a.parentId" property="parentId" jdbcType="BIGINT"/>
        <result column="a.orgCode" property="orgCode" jdbcType="VARCHAR"/>
        <result column="a.orgName" property="orgName" jdbcType="VARCHAR"/>
