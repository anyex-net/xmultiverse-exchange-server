            </if>
            <if test="sortNum != null">
                sortNum = #{sortNum} ,
            </if>
            <if test="remark != null">
                remark = #{remark}
            </if>
        </set>
        where id = #{id}
    </update>

    <!-- 批量插入 -->
    <insert id="insertBatch" parameterType="list">
        insert into SysOrganization(
        id ,
        parentId ,
        orgCode ,
        orgName ,
        orgDest ,
        createBy ,
        createDate ,
        updateBy ,
        updateDate ,
        sortNum ,
        remark
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id}  ,
            #{item.parentId}  ,
            #{item.orgCode}  ,
            #{item.orgName}  ,
            #{item.orgDest}  ,
            #{item.createBy}  ,
            #{item.createDate}  ,
            #{item.updateBy}  ,
            #{item.updateDate}  ,
            #{item.sortNum} ,
            #{item.remark}
            )
        </foreach>
    </insert>

    <!-- 批量修改 -->
    <update id="updateBatch" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update SysOrganization set
            parentId = #{item.parentId} ,
            orgCode = #{item.orgCode} ,
            orgName = #{item.orgName} ,
            orgDest = #{item.orgDest} ,
            createBy = #{item.createBy} ,
            createDate = #{item.createDate} ,
            updateBy = #{item.updateBy} ,
            updateDate = #{item.updateDate} ,
            sortNum = #{item.sortNum} ,
            remark = #{item.remark}
            where id = #{item.id}
        </foreach>
    </update>

    <!-- 根据主键更新一条信息所有数据 -->
    <update id="updateByPrimaryKey" parameterType="com.anyex.apps.system.entity.SysOrganization">
        update SysOrganization set
        parentId = #{parentId} ,
        orgCode = #{orgCode} ,
        orgName = #{orgName} ,
        orgDest = #{orgDest} ,
        createBy = #{createBy} ,
        createDate = #{createDate} ,
        updateBy = #{updateBy} ,
        updateDate = #{updateDate} ,
        sortNum = #{sortNum} ,
        remark = #{remark}
        where id = #{id}
    </update>

    <!-- 根据主键取数据 -->
    <select id="selectByPrimaryKey"  parameterType="java.lang.Long" resultType="com.anyex.apps.system.entity.SysOrganization">
        select <include refid="organizationColumns"/> from SysOrganization a where a.id = #{id}
    </select>

    <!-- 可分页的对象查询 -->
    <select id="findList" resultType="com.anyex.apps.system.entity.SysOrganization">
        SELECT
        <include refid="organizationJoinColumns"/>
        FROM SysOrganization a LEFT JOIN SysUserInfo b
        ON b.id = a.createBy WHERE 1 = 1
        <choose>
            <when test="parentId != null">
                and a.parentId = #{parentId}
            </when>
            <otherwise>
                and a.parentId is null
            </otherwise>
        </choose>
        <if test="orgCode != null and orgCode != ''">
            and a.orgCode like CONCAT('%',#{orgCode}, '%')
        </if>
        <if test="orgName != null and orgName != ''">
            and a.orgName like CONCAT('%',#{orgName}, '%')
        </if>
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultType="com.anyex.apps.system.entity.SysOrganization">
        SELECT
        <!--
        id ,
        parentId ,
        orgName
        -->
        <include refid="organizationColumns"/>
        FROM SysOrganization a WHERE 1 = 1
    </select>

</mapper>