    <!-- 选择性更新数据 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.anyex.apps.system.entity.SysOrganization">
        update SysOrganization
        <set>
            <if test="parentId != null">
                parentId = #{parentId} ,
            </if>
            <if test="orgCode != null">
                orgCode = #{orgCode} ,
            </if>
            <if test="orgName != null">
                orgName = #{orgName} ,
            </if>
            <if test="orgDest != null">
                orgDest = #{orgDest} ,
            </if>
            <if test="createBy != null">
                createBy = #{createBy} ,
            </if>
            <if test="createDate != null">
                createDate = #{createDate} ,
            </if>
            <if test="updateBy != null">
                updateBy = #{updateBy} ,
            </if>
            <if test="updateDate != null">
