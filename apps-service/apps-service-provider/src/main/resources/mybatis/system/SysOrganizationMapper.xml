        <result column="a.createDate" property="createDate" jdbcType="BIGINT"/>
        <result column="a.updateBy" property="updateBy" jdbcType="VARCHAR"/>
        <result column="a.updateDate" property="updateDate" jdbcType="BIGINT"/>
        <result column="a.sortNum" property="sortNum" jdbcType="INTEGER"/>
        <result column="a.remark" property="remark" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 普通插入 -->
    <insert id="insert" parameterType="com.anyex.apps.system.entity.SysOrganization">
        insert into SysOrganization(
        id ,
        parentId ,
        orgCode ,
        orgName ,
        orgDest ,
        createBy ,
        createDate ,
        updateBy ,
        updateDate ,
        sortNum ,
        remark
        ) VALUES (
        #{id} ,
        #{parentId} ,
        #{orgCode} ,
        #{orgName} ,
        #{orgDest} ,
        #{createBy} ,
        #{createDate} ,
        #{updateBy} ,
        #{updateDate} ,
        #{sortNum} ,
        #{remark}
        )
    </insert>
    <!-- 根据主键物理删除 -->
    <delete id="remove" parameterType="java.lang.Long">
        delete from SysOrganization where id = #{id}
    </delete>

    <!-- 根据主键逻辑删除 -->
    <update id="delete" parameterType="java.lang.Long">
        update SysOrganization set 1 = 1 where id = #{id}
    </update>

    <!--根据条件是否插入数据 -->
    <insert id="insertSelective" parameterType="com.anyex.apps.system.entity.SysOrganization">
