    <!-- 选择性更新数据 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.anyex.apps.system.entity.SysAccessLog">
        UPDATE SysAccessLog
           <set>
            <if test="id != null">
                id = #{id} ,
            </if>
            <if test="userName != null">
                userName = #{userName} ,
            </if>
            <if test="module != null">
