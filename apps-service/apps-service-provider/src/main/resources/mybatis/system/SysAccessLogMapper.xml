        UPDATE SysAccessLog SET
            id = #{id} ,
            userName = #{userName} ,
            module = #{module} ,
            method = #{method} ,
            type = #{type} ,
            remark = #{remark} ,
            reqParam = #{reqParam} ,
            respParam = #{respParam} ,
            uri = #{uri} ,
            ip = #{ip} ,
