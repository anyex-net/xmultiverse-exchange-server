    <!-- 普通插入 -->
    <insert id="insert" parameterType="com.anyex.apps.system.entity.SysAccessLog">
        INSERT INTO SysAccessLog(
            id ,
            userName ,
            module ,
            method ,
            type ,
            remark ,
            reqParam ,
            respParam ,
            uri ,
            ip ,
            createDate 
        ) VALUES (
            #{id} ,
            #{userName} ,
            #{module} ,
            #{method} ,
            #{type} ,
            #{remark} ,
            #{reqParam} ,
            #{respParam} ,
            #{uri} ,
            #{ip} ,
            #{createDate} 
        )
    </insert>
    <!-- 根据主键物理删除 -->
    <delete id="remove" parameterType="java.lang.Long">
        DELETE FROM SysAccessLog WHERE ID = #{id}
    </delete>

    <!-- 根据主键逻辑删除
    <update id="delete" parameterType="java.lang.Long">
