    <!-- 根据主键取数据 -->
    <select id="selectByPrimaryKey"  parameterType="java.lang.Long" resultType="com.anyex.apps.system.entity.SysAccessLog">
        SELECT <include refid="accessLogColumns"/> FROM SysAccessLog a WHERE a.ID = #{id}
    </select>

    <!-- 可分页的对象查询 -->
    <select id="findList" resultType="com.anyex.apps.system.entity.SysAccessLog">
        SELECT
        <include refid="accessLogColumns"/>
        FROM SysAccessLog a WHERE 1 = 1 <!-- and a.DEL_FLAG = 0-->
        <if test="id != null">
            AND a.id LIKE CONCAT('%',#{id}, '%') 
        </if>
        <if test="userName != null">
            AND a.userName = #{userName}
        </if>
        <if test="module != null">
            AND a.module LIKE CONCAT('%',#{module}, '%') 
        </if>
        <if test="method != null">
            AND a.method LIKE CONCAT('%',#{method}, '%') 
        </if>
        <if test="type != null">
            AND a.type LIKE CONCAT('%',#{type}, '%') 
        </if>
        <if test="remark != null">
            AND a.remark LIKE CONCAT('%',#{remark}, '%')
        </if>
        <if test="reqParam != null">
            AND a.reqParam LIKE CONCAT('%',#{reqParam}, '%') 
        </if>
        <if test="respParam != null">
            AND a.respParam LIKE CONCAT('%',#{respParam}, '%')
        </if>
        <if test="uri != null">
            AND a.uri LIKE CONCAT('%',#{uri}, '%') 
        </if>
        <if test="ip != null">
            AND a.ip LIKE CONCAT('%',#{ip}, '%') 
        </if>
        <if test="createDate != null">
            AND a.createDate = #{createDate}
        </if>
        order by a.createDate desc
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultType="com.anyex.apps.system.entity.SysAccessLog">
