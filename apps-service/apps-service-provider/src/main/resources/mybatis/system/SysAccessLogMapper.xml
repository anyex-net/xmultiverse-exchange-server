    <!-- 批量修改 -->
    <update id="updateBatch" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            UPDATE SysAccessLog SET
            id = #{item.id} ,
            userName = #{item.userName} ,
            module = #{item.module} ,
            method = #{item.method} ,
            type = #{item.type} ,
            remark = #{item.remark} ,
            reqParam = #{item.reqParam} ,
