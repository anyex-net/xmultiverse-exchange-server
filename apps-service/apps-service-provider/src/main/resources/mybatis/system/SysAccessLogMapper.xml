<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anyex.apps.system.mapper.SysAccessLogMapper">
    <!-- 基础列 -->
    <sql id="accessLogColumns">
        a.id as id,
        a.userName as userName,
        a.module as module,
        a.method as method,
        a.type as type,
        a.remark as remark,
        a.reqParam as reqParam,
        a.respParam as respParam,
        a.uri as uri,
        a.ip as ip,
        a.createDate as createDate
