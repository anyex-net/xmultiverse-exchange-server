    <!-- 可分页的对象查询 -->
    <select id="findList" resultType="com.anyex.apps.account.entity.AccountReceivingBank">
        SELECT
        <include refid="accountReceivingBankColumns"/>
        FROM AccountReceivingBank a WHERE 1 = 1 <!-- and a.DEL_FLAG = 0-->
        <if test="accountId != null">
            AND a.accountId = #{accountId}
        </if>
        <if test="accountType != null">
            AND a.accountType LIKE CONCAT('%',#{accountType}, '%') 
        </if>
        <if test="accountNo != null">
            AND a.accountNo LIKE CONCAT('%',#{accountNo}, '%') 
        </if>
        <if test="accountName != null">
            AND a.accountName LIKE CONCAT('%',#{accountName}, '%') 
        </if>
        <if test="bankName != null">
            AND a.bankName LIKE CONCAT('%',#{bankName}, '%') 
