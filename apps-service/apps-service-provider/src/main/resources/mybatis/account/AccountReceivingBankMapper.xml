        </if>
        <if test="cnic != null">
            AND a.cnic LIKE CONCAT('%',#{cnic}, '%') 
        </if>
        <if test="email != null">
            AND a.email LIKE CONCAT('%',#{email}, '%') 
        </if>
        <if test="mobile != null">
            AND a.mobile LIKE CONCAT('%',#{mobile}, '%') 
        </if>
        <if test="status != null">
            and a.status = #{status}
        </if>
