<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anyex.apps.operation.mapper.AppActivationInfoMapper">
    <!-- 基础列 -->
    <sql id="appActivationInfoColumns">
        a.id as id,
        a.ip as ip,
        a.deviceId as deviceId,
        a.appVersion as appVersion,
        a.source as source,
        a.remark as remark,
        a.createTime as createTime,
        a.updateTime as updateTime
    </sql>

    <resultMap id="appActivationInfoResultMap" type="com.anyex.apps.operation.entity.AppActivationInfo">
        <id column="ID" property="id" />
        <result column="ip" property="ip"/>
        <result column="deviceId" property="deviceId"/>
        <result column="appVersion" property="appVersion"/>
        <result column="source" property="source"/>
        <result column="remark" property="remark"/>
        <result column="createTime" property="createTime"/>
        <result column="updateTime" property="updateTime"/>
    </resultMap>

    <!-- 普通插入 -->
    <insert id="insert" parameterType="com.anyex.apps.operation.entity.AppActivationInfo">
        INSERT INTO AppActivationInfo(
            id ,
            ip ,
            deviceId ,
            appVersion ,
            source ,
            remark ,
            createTime ,
            updateTime 
        ) VALUES (
            #{id} ,
            #{ip} ,
            #{deviceId} ,
            #{appVersion} ,
            #{source} ,
            #{remark} ,
            #{createTime} ,
            #{updateTime} 
        )
    </insert>
    <!-- 根据主键物理删除 -->
    <delete id="remove" parameterType="java.lang.Long">
        DELETE FROM AppActivationInfo WHERE ID = #{id}
    </delete>

    <!-- 根据主键逻辑删除
    <update id="delete" parameterType="java.lang.Long">
        UPDATE AppActivationInfo SET DEL_FLAG = 1 WHERE ID = #{id}
    </update>
    -->

    <!--根据条件是否插入数据 -->
    <insert id="insertSelective" parameterType="com.anyex.apps.operation.entity.AppActivationInfo">
        INSERT INTO AppActivationInfo
        <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="id != null">
                id ,
        </if>
        <if test="ip != null">
                ip ,
        </if>
        <if test="deviceId != null">
                deviceId ,
        </if>
        <if test="appVersion != null">
                appVersion ,
        </if>
        <if test="source != null">
                source ,
        </if>
        <if test="remark != null">
                remark ,
        </if>
        <if test="createTime != null">
                createTime ,
        </if>
        <if test="updateTime != null">
                updateTime 
        </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
        <if test="id != null">
                #{id} ,
        </if>
        <if test="ip != null">
                #{ip} ,
        </if>
        <if test="deviceId != null">
                #{deviceId} ,
        </if>
        <if test="appVersion != null">
                #{appVersion} ,
        </if>
        <if test="source != null">
                #{source} ,
        </if>
        <if test="remark != null">
                #{remark} ,
        </if>
        <if test="createTime != null">
                #{createTime} ,
        </if>
        <if test="updateTime != null">
                #{updateTime} 
        </if>
        </trim>
    </insert>

    <!-- 选择性更新数据 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.anyex.apps.operation.entity.AppActivationInfo">
        UPDATE AppActivationInfo
           <set>
            <if test="ip != null">
                ip = #{ip} ,
            </if>
            <if test="deviceId != null">
                deviceId = #{deviceId} ,
            </if>
            <if test="appVersion != null">
                appVersion = #{appVersion} ,
            </if>
            <if test="source != null">
                source = #{source} ,
            </if>
            <if test="remark != null">
                remark = #{remark} ,
            </if>
            <if test="createTime != null">
                createTime = #{createTime} ,
            </if>
            <if test="updateTime != null">
                updateTime = #{updateTime} 
            </if>
           </set>
        WHERE ID = #{id}
    </update>

    <!-- 批量插入 -->
    <insert id="insertBatch" parameterType="list">
        INSERT INTO AppActivationInfo(
            id ,
            ip ,
            deviceId ,
            appVersion ,
            source ,
            remark ,
            createTime ,
            updateTime 
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id} ,
            #{item.ip} ,
            #{item.deviceId} ,
            #{item.appVersion} ,
            #{item.source} ,
            #{item.remark} ,
            #{item.createTime} ,
            #{item.updateTime} 
            )
        </foreach>
    </insert>

    <!-- 批量修改 -->
    <update id="updateBatch" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            UPDATE AppActivationInfo SET
            ip = #{item.ip} ,
            deviceId = #{item.deviceId} ,
            appVersion = #{item.appVersion} ,
            source = #{item.source} ,
            remark = #{item.remark} ,
            createTime = #{item.createTime} ,
            updateTime = #{item.updateTime} 
            WHERE ID = #{item.id}
        </foreach>
    </update>

    <!-- 根据主键更新一条信息所有数据 -->
    <update id="updateByPrimaryKey" parameterType="com.anyex.apps.operation.entity.AppActivationInfo">
        UPDATE AppActivationInfo SET
            ip = #{ip} ,
            deviceId = #{deviceId} ,
            appVersion = #{appVersion} ,
            source = #{source} ,
            remark = #{remark} ,
            createTime = #{createTime} ,
            updateTime = #{updateTime} 
        WHERE ID = #{id}
    </update>

    <!-- 根据主键取数据 -->
    <select id="selectByPrimaryKey"  parameterType="java.lang.Long" resultType="com.anyex.apps.operation.entity.AppActivationInfo">
        SELECT <include refid="appActivationInfoColumns"/> FROM AppActivationInfo a WHERE a.ID = #{id}
    </select>

    <!-- 可分页的对象查询 -->
    <select id="findList" resultType="com.anyex.apps.operation.entity.AppActivationInfo">
        SELECT
        <include refid="appActivationInfoColumns"/>
        FROM AppActivationInfo a WHERE 1 = 1
        <if test="ip != null and ip != ''">
            AND a.ip LIKE CONCAT('%',#{ip}, '%')
            /** AND a.ip = #{ip} */
        </if>
        <if test="deviceId != null and deviceId != ''">
            AND a.deviceId LIKE CONCAT('%',#{deviceId}, '%')
            /** AND a.deviceId = #{deviceId} */
        </if>
        <if test="appVersion != null and appVersion != ''">
            AND a.appVersion LIKE CONCAT('%',#{appVersion}, '%')
            /** AND a.appVersion = #{appVersion} */
        </if>
        <if test="source != null and source != ''">
            AND a.source LIKE CONCAT('%',#{source}, '%')
            /** AND a.source = #{source} */
        </if>
        <if test="remark != null and remark != ''">
            AND a.remark LIKE CONCAT('%',#{remark}, '%')
            /** AND a.remark = #{remark} */
        </if>
        <if test="createTime != null">
            AND a.createTime = #{createTime}
        </if>
        <if test="updateTime != null">
            AND a.updateTime = #{updateTime}
        </if>
        order by a.createTime desc
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultType="com.anyex.apps.operation.entity.AppActivationInfo">
        SELECT
        <include refid="appActivationInfoColumns"/>
        FROM AppActivationInfo a
    </select>

</mapper>

