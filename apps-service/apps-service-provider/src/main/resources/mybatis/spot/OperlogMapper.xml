<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anyex.apps.spot.mapper.OperlogMapper">
    <!-- 基础列 -->
    <sql id="operlogExampleColumns">
        a.id as id,
        a.time as time,
        a.detail as detail
    </sql>

    <resultMap id="operlogExampleResultMap" type="com.anyex.apps.spot.entity.Operlog">
        <id column="ID" property="id" />
        <result column="time" property="time"/>
        <result column="detail" property="detail"/>
    </resultMap>

    <!-- 普通插入 -->
    <insert id="insert" parameterType="com.anyex.apps.spot.entity.Operlog">
        INSERT INTO operlog_example(
            id ,
            time ,
            detail 
        ) VALUES (
            #{id} ,
            #{time} ,
            #{detail} 
        )
    </insert>
    <!-- 根据主键物理删除 -->
    <delete id="remove" parameterType="java.lang.Long">
        DELETE FROM operlog_example WHERE ID = #{id}
    </delete>

    <!-- 根据主键逻辑删除
    <update id="delete" parameterType="java.lang.Long">
        UPDATE operlog_example SET DEL_FLAG = 1 WHERE ID = #{id}
    </update>
    -->

    <!--根据条件是否插入数据 -->
    <insert id="insertSelective" parameterType="com.anyex.apps.spot.entity.Operlog">
        INSERT INTO operlog_example
        <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="id != null">
                id ,
        </if>
        <if test="time != null">
                time ,
        </if>
        <if test="detail != null">
                detail 
        </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
        <if test="id != null">
                #{id} ,
        </if>
        <if test="time != null">
                #{time} ,
        </if>
        <if test="detail != null">
                #{detail} 
        </if>
        </trim>
    </insert>

    <!-- 选择性更新数据 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.anyex.apps.spot.entity.Operlog">
        UPDATE operlog_example
           <set>
            <if test="time != null">
                time = #{time} ,
            </if>
            <if test="detail != null">
                detail = #{detail} 
            </if>
           </set>
        WHERE ID = #{id}
    </update>

    <!-- 批量插入 -->
    <insert id="insertBatch" parameterType="list">
        INSERT INTO operlog_example(
            id ,
            time ,
            detail 
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id} ,
            #{item.time} ,
            #{item.detail} 
            )
        </foreach>
    </insert>

    <!-- 批量修改 -->
    <update id="updateBatch" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            UPDATE operlog_example SET
            time = #{item.time} ,
            detail = #{item.detail} 
            WHERE ID = #{item.id}
        </foreach>
    </update>

    <!-- 根据主键更新一条信息所有数据 -->
    <update id="updateByPrimaryKey" parameterType="com.anyex.apps.spot.entity.Operlog">
        UPDATE operlog_example SET
            time = #{time} ,
            detail = #{detail} 
        WHERE ID = #{id}
    </update>

    <!-- 根据主键取数据 -->
    <select id="selectByPrimaryKey"  parameterType="java.lang.Long" resultType="com.anyex.apps.spot.entity.Operlog">
        SELECT <include refid="operlogExampleColumns"/> FROM operlog_example a WHERE a.ID = #{id}
    </select>

    <!-- 查询一条记录 -->
    <select id="selectOne" resultType="com.anyex.apps.spot.entity.Operlog">
        SELECT
        <include refid="operlogExampleColumns"/>
        FROM operlog_example a WHERE 1 = 1
        <if test="time != null">
            AND a.time = #{time}
        </if>
        <if test="detail != null and detail != ''">
            AND a.detail = #{detail}
        </if>
        limit 1
    </select>

    <!-- 可分页的对象查询 -->
    <select id="findList" resultType="com.anyex.apps.spot.entity.Operlog">
        SELECT
        <include refid="operlogExampleColumns"/>
        FROM operlog_example a WHERE 1 = 1
        <if test="time != null">
            AND a.time = #{time}
        </if>
        <if test="detail != null and detail != ''">
            AND a.detail LIKE CONCAT('%',#{detail}, '%')
        </if>
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultType="com.anyex.apps.spot.entity.Operlog">
        SELECT
        <include refid="operlogExampleColumns"/>
        FROM operlog_example a
    </select>


</mapper>

