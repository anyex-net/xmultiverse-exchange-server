<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sofa="http://sofastack.io/schema/sofaboot"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://sofastack.io/schema/sofaboot http://sofastack.io/schema/sofaboot.xsd">

    <!-- 用户服务 -->
    <sofa:reference id="userService" interface="com.anyex.apps.user.service.UserService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 充值地址服务 -->
    <sofa:reference id="depositAddressService" interface="com.anyex.apps.fund.service.DepositAddressService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 充值交易历史服务 -->
    <sofa:reference id="depositTransHistoryService" interface="com.anyex.apps.fund.service.DepositTransHistoryService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 提现历史服务 -->
    <sofa:reference id="withdrawalHistoryService" interface="com.anyex.apps.fund.service.WithdrawalHistoryService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 资金账户余额 -->
    <sofa:reference id="balancesService" interface="com.anyex.apps.fund.service.BalancesService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 资金账户交易历史 -->
    <sofa:reference id="balancesTransHistoryService" interface="com.anyex.apps.fund.service.BalancesTransHistoryService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>

    <!-- RWA机构SPV产品分红记录 -->
    <sofa:reference id="rwaInstSpvProductDividendService" interface="com.anyex.apps.rwa.service.RwaInstSpvProductDividendService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>

    <!-- 平台交易产品 -->
    <sofa:reference id="instrumentsService" interface="com.anyex.apps.base.service.InstrumentsService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 平台交易手续费费率 -->
    <sofa:reference id="instTradeFeeService" interface="com.anyex.apps.base.service.InstTradeFeeService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 用户交易手续费费率 -->
    <sofa:reference id="userInstTradeFeeService" interface="com.anyex.apps.base.service.UserInstTradeFeeService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>

    <!-- 用户持有数量奖励配置 -->
    <sofa:reference id="userHoldAmountRewardConfigService" interface="com.anyex.apps.user.service.UserHoldAmountRewardConfigService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <!-- 用户邀请返佣奖励配置 -->
    <sofa:reference id="userInviteRewardConfigService" interface="com.anyex.apps.user.service.UserInviteRewardConfigService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>

    <sofa:reference id="userInviteService" interface="com.anyex.apps.user.service.UserInviteService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>
    <sofa:reference id="userRebateService" interface="com.anyex.apps.user.service.UserRebateService" jvm-first="false">
        <sofa:binding.bolt>
            <sofa:global-attrs timeout="30000" address-wait-time="30000"/>
        </sofa:binding.bolt>
    </sofa:reference>

</beans>
